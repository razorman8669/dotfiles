[user]
	name = Ray Marceau
	email = ray@raymarceau.com

[includeIf "gitdir:~/dev/slackincode.github.io"]
    path = ~/dev/slackincode.github.io/.gitconfig

[includeIf "gitdir:~/dev/purse"]
    path = ~/dev/purse/.gitconfig


# Makes pushing easier on master branch
# [branch "master"]
# 	remote = origin
# 	merge = refs/heads/master

[url "git@github.com"]
	insteadOf = gh

# Start other core configuration
[alias]
    co = checkout
    mm = merge origin/master
	credit = commit --amend --author "$1 <$2>" -C HEAD
	unstage = reset HEAD --
	fuckit = reset --hard HEAD
	last = log -1 HEAD --stat --relative-date
	subupdate = submodule foreach git fetch origin
	squash = merge --squash --no-commit
	mff = merge --no-ff --log
	new = log master..origin/master --stat
	ll = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
	lls = !git ll --stat
	exportfiles = !sh -c 'git diff $0 --name-only | "while read files; do mkdir -p \"$1/$(dirname $files)\"; cp -vf $files $1/$(dirname $files); done"'
	rmerge = !git checkout -b $1 origin/$1 && git checkout ${2:-master} && git merge --no-ff $1 && git branch -D $1
    ; merge-log - shows the commits inlcuded by a merge; usage: `git mlog [commit] [log-options]`
	mlog = "!f() { args=(\"${@-HEAD}\"); if [[ ${args[0]} == \"-\"* ]]; then args=(\"HEAD\" \"${args[@]}\"); fi; git log \"${args[0]}^..${args[0]}\" ${args[@]:1}; }; f"
[color]
	ui = yes

[core]
	autocrlf = input
	excludesfile = /Users/razor/.gitignore_global
	editor = vim
	precomposeUnicode = true

[merge]
	conflictstyle = diff3

[rebase]
	stat = yes
	autostash = true
# [push]
# 	default = simple
# [filter "media"]
# 	required = true
# 	clean = git media clean %f
# 	smudge = git media smudge %f
# [filter "lfs"]
# 	clean = git-lfs clean %f
# 	smudge = git-lfs smudge %f
# 	required = true
# [commit]
# 	gpgsign = true
[credential]
	helper = osxkeychain
[pull]
    # rebase = true
[push]
    default = current
[commit]
	template = /Users/razor/.stCommitMsg
[gpg]
	program = gpg2
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
