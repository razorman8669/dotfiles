#!/bin/bash

# Miners
alias tunnelEthRemoteNode="((sleep 5 && open 'http://127.0.0.1:8180/#/auth?token=REDACTED')&) && ssh -L 8545:127.0.0.1:8545 -L 8546:127.0.0.1:8546 -L 8180:127.0.0.1:8180 ubuntu@ec2-52-25-50-138.us-west-2.compute.amazonaws.com -i ~/.ssh/miningllc.pem"
alias tunnelSmartWallet="((sleep 5 && open 'vnc://127.0.0.1:5901')&) && ssh -i '~/.ssh/miningllc.pem' -L 5901:127.0.0.1:5901 ubuntu@ec2-34-216-88-229.us-west-2.compute.amazonaws.com"
alias sshEthRemoteNode="ssh ubuntu@ec2-52-25-50-138.us-west-2.compute.amazonaws.com -i ~/.ssh/miningllc.pem"
alias sshMN1="ssh -i ~/.ssh/miningllc.pem ubuntu@ec2-34-214-166-76.us-west-2.compute.amazonaws.com"
alias sshMN2="ssh -i ~/.ssh/miningllc.pem ubuntu@ec2-52-38-180-154.us-west-2.compute.amazonaws.com"
alias sshMN3="ssh -i ~/.ssh/miningllc.pem ubuntu@ec2-34-208-102-148.us-west-2.compute.amazonaws.com"
alias sshMN4="ssh -i ~/.ssh/miningllc.pem ubuntu@ec2-34-208-164-206.us-west-2.compute.amazonaws.com"
alias sshMNJew="ssh -i ~/.ssh/miningllc.pem ubuntu@ec2-34-215-204-39.us-west-2.compute.amazonaws.com"
alias sshTierionMN="ssh -i ~/.ssh/miningllc.pem ubuntu@ec2-52-24-17-117.us-west-2.compute.amazonaws.com"
alias sshTierionMN2="ssh -i ~/.ssh/miningllc.pem ubuntu@34.215.171.223"
alias sshTierionMN3="ssh -i ~/.ssh/miningllc.pem ubuntu@34.218.86.227"
alias sshTierionMN4="ssh -i ~/.ssh/miningllc.pem ubuntu@34.218.86.54"
alias sshVPN="ssh -i ~/.ssh/scileadsvpn.pem ubuntu@35.182.42.78"
alias sshRemoteNode="ssh -i ~/.ssh/miningllc.pem ubuntu@34.218.184.119"
alias sshEtnWallet="ssh -i ~/.ssh/miningllc.pem ubuntu@ec2-35-164-2-179.us-west-2.compute.amazonaws.com"


# LS aliases
# Detect which `ls` flavor is in use
if ls --color > /dev/null 2>&1; then # GNU `ls`
  colorflag="--color"
else # OS X `ls`
  colorflag="-G"
fi
# List all files colorized in long format
alias ll='ls -lh'
# List all files colorized in long format, including dot files
alias la="ls -lha"
# List only directories
alias lsd='ls -l | grep "^d"'
# Always use color output for `ls`
alias ls="command ls -a ${colorflag}"
export LS_COLORS='no=00:fi=00:di=01;34:ln=01;36:pi=40;33:so=01;35:do=01;35:bd=40;33;01:cd=40;33;01:or=40;31;01:ex=01;32:*.tar=01;31:*.tgz=01;31:*.arj=01;31:*.taz=01;31:*.lzh=01;31:*.zip=01;31:*.z=01;31:*.Z=01;31:*.gz=01;31:*.bz2=01;31:*.deb=01;31:*.rpm=01;31:*.jar=01;31:*.jpg=01;35:*.jpeg=01;35:*.gif=01;35:*.bmp=01;35:*.pbm=01;35:*.pgm=01;35:*.ppm=01;35:*.tga=01;35:*.xbm=01;35:*.xpm=01;35:*.tif=01;35:*.tiff=01;35:*.png=01;35:*.mov=01;35:*.mpg=01;35:*.mpeg=01;35:*.avi=01;35:*.fli=01;35:*.gl=01;35:*.dl=01;35:*.xcf=01;35:*.xwd=01;35:*.ogg=01;35:*.mp3=01;35:*.wav=01;35:'


# Shortcuts
alias reloadcli="source $HOME/.bashrc"
alias reloaddns="dscacheutil -flushcache && sudo killall -HUP mDNSResponder"

# Directories
alias dotfiles="cd $DOTFILES"

# Docker
_docker-container-names(){
        local cur=${COMP_WORDS[COMP_CWORD]}
        __docker_complete_container_names
}

alias dk="docker"
complete -F _docker dk

alias dps="docker ps -a"

alias dkl='docker logs -f'
complete -F _docker-container-names dkl

alias dc="docker-compose"
complete -F _docker_compose dc

alias dkrmall="docker rm \$(docker ps -aq)"

docker-restart-logs(){
        # $1 == container
        docker restart $1 && docker logs -f $1
}
alias dkr="docker restart $1"
complete -F _docker-container-names dkr

alias dkrl='docker-restart-logs'
complete -F _docker-container-names dkrl


# Git
alias commit="git add . && git commit -m"
alias gcommit="git add . && git commit"
alias gst="git status"
alias gc="git checkout"
alias gd="git diff"
alias gl="git log --oneline --decorate --color"
