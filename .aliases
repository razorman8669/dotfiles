#!/bin/bash

# Load any private aliases
if [ -f "$HOME/.private_aliases" ]; then . "$HOME/.private_aliases"; fi

# LS aliases
# Detect which `ls` flavor is in use
if ls --color > /dev/null 2>&1; then # GNU `ls`
  colorflag="--color"
else # OS X `ls`
  colorflag="-G"
fi
# List all files colorized in long format
alias ll='ls -lh'
# List all files colorized in long format, including dot files
alias la="ls -lha"
# List only directories
alias lsd='ls -l | grep "^d"'
# Always use color output for `ls`
alias ls="command ls -a ${colorflag}"
export LS_COLORS='no=00:fi=00:di=01;34:ln=01;36:pi=40;33:so=01;35:do=01;35:bd=40;33;01:cd=40;33;01:or=40;31;01:ex=01;32:*.tar=01;31:*.tgz=01;31:*.arj=01;31:*.taz=01;31:*.lzh=01;31:*.zip=01;31:*.z=01;31:*.Z=01;31:*.gz=01;31:*.bz2=01;31:*.deb=01;31:*.rpm=01;31:*.jar=01;31:*.jpg=01;35:*.jpeg=01;35:*.gif=01;35:*.bmp=01;35:*.pbm=01;35:*.pgm=01;35:*.ppm=01;35:*.tga=01;35:*.xbm=01;35:*.xpm=01;35:*.tif=01;35:*.tiff=01;35:*.png=01;35:*.mov=01;35:*.mpg=01;35:*.mpeg=01;35:*.avi=01;35:*.fli=01;35:*.gl=01;35:*.dl=01;35:*.xcf=01;35:*.xwd=01;35:*.ogg=01;35:*.mp3=01;35:*.wav=01;35:'


# Shortcuts
alias reloadcli="source $HOME/.bashrc"
alias reloaddns="dscacheutil -flushcache && sudo killall -HUP mDNSResponder"

# Directories
alias dotfiles="cd $DOTFILES"

# Docker
# Allows for autocomplete of container names
_docker-container-names(){
    local cur=${COMP_WORDS[COMP_CWORD]}
    __docker_complete_containers
}

alias dm='docker-machine'
alias d="docker"
alias dk="d"

complete -F _docker d

alias dps="docker ps -a"

docker-logs(){
  docker logs -f --tail ${2-100} $1 2>&1
}
alias dkl='docker-logs'
complete -F _docker-container-names dkl
alias dl="dkl"
complete -F _docker-container-names dl

docker-exec(){
    docker exec -it $1 sh
}
alias dkexec='docker-exec'
complete -F _docker-container-names dkexec

alias dc="docker-compose"

alias dkrmall="docker rm \$(docker ps -aq)"

alias dkr="docker restart $1"
complete -F _docker-container-names dkr

docker-restart-logs(){
    # $1 == container
    docker restart $1 && docker logs -f --tail ${2-100} $1
}
alias dkrl='docker-restart-logs'
complete -F _docker-container-names dkrl

# Easier navigation
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."

# system monitoring
alias pingg="docker run --rm -it pingg-ray" # make sure to run 'docker build -t pingg-ray' inside ~/dev/pingg
alias whatismyip="curl -s checkip.dyndns.org|sed -e 's/.*Current IP Address: //' -e 's/<.*$//'"
alias speedtest="wget -O /dev/null --progress=dot:mega  http://50.23.64.58/downloads/test100.zip; date"

# Tailscale
alias tailscale="/Applications/Tailscale.app/Contents/MacOS/Tailscale"

# Git
alias g="git"
alias gst="git status"
alias gc="git checkout"
alias gd="git diff"
alias gl="git log --oneline --decorate --color"
