{
    "[dockercompose]": {
        "editor.defaultFormatter": "ms-azuretools.vscode-docker"
    },
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features"
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.python"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "application.shellEnvironmentResolutionTimeout": 20,
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.acceptSuggestionOnCommitCharacter": false,
    "editor.bracketPairColorization.enabled": true,
    "editor.find.cursorMoveOnType": false,
    "editor.foldingMaximumRegions": 8000,
    "editor.fontFamily": "'Fira Code', Menlo, Monaco, 'Courier New', monospace",
    "editor.fontLigatures": false,
    "editor.guides.bracketPairs": true,
    "editor.minimap.maxColumn": 60,
    "editor.minimap.renderCharacters": false,
    "editor.minimap.showSlider": "always",
    "editor.minimap.size": "fit",
    "editor.stickyScroll.enabled": true,
    "workbench.tree.enableStickyScroll": true,
    "editor.suggest.localityBonus": true,
    "editor.tabCompletion": "on",
    "editor.wordWrapColumn": 120,
    "eslint.codeAction.disableRuleComment": {},
    "explorer.openEditors.visible": 1,
    "extensions.autoUpdate": false,
    "extensions.ignoreRecommendations": false,
    "files.autoSave": "onFocusChange",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.detectSubmodulesLimit": 15,
    "gitlens.advanced.messages": {
        "suppressLineUncommittedWarning": true
    },
    "gitlens.advanced.telemetry.enabled": false,
    "gitlens.codeLens.enabled": false,
    "gitlens.graph.statusBar.enabled": false,
    // "gitlens.hovers.currentLine.over": "line",
    "gitlens.integrations.enabled": true,
    "gitlens.plusFeatures.enabled": false,
    "gitlens.telemetry.enabled": false,
    "prettier.jsxSingleQuote": true,
    "prettier.printWidth": 120,
    "prettier.singleQuote": true,
    "python.disableInstallationCheck": true,
    "python.languageServer": "Pylance",
    "redhat.telemetry.enabled": false,
    "search.exclude": {
        "**/dist": true
    },
    "search.searchOnType": false,
    "telemetry.enableCrashReporter": false,
    "telemetry.enableTelemetry": false,
    "telemetry.telemetryLevel": "off",
    "terminal.integrated.scrollback": 10000,
    "terminal.integrated.smoothScrolling": true,
    "typescript.updateImportsOnFileMove.enabled": "always",
    "update.mode": "start",
    "window.nativeTabs": true,
    "window.title": "${activeEditorMedium}${dirty}${separator}${rootName}",
    "window.titleBarStyle": "native",
    "workbench.colorTheme": "Base16 Tomorrow Dark",
    "workbench.editor.tabCloseButton": "left",
    "workbench.editor.tabSizing": "shrink",
    "workbench.list.horizontalScrolling": true,
    "workbench.startupEditor": "none",
    "editor.scrollBeyondLastColumn": 8,
    "editor.scrollBeyondLastLine": false,
    "editor.mouseWheelScrollSensitivity": 0.5,
    "editor.smoothScrolling": true,
    "workbench.list.mouseWheelScrollSensitivity": 0.2,
    "editor.scrollbar.verticalScrollbarSize": 18,
    "tabnine.experimentalAutoImports": true,
    "githubPullRequests.pushBranch": "always",
    "git.openRepositoryInParentFolders": "never",
    "explorer.confirmDragAndDrop": false,
    "search.useParentIgnoreFiles": true,
    "terminal.integrated.fontFamily": "Hack Nerd Font",
    "githubPullRequests.pullBranch": "never",
    "workbench.editor.tabActionLocation": "left",
    "workbench.editor.editorActionsLocation": "titleBar",
    "breadcrumbs.enabled": false,
    "workbench.activityBar.location": "bottom"
}
